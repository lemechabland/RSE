












QMainWindow {
  background: #f8fafc;
  color: #111827;
  font-family: Segoe UI, Arial, sans-serif;
  font-size: 13px;
}

QMenuBar {
  background: #f8fafc;
  color: #111827;
}

QMenuBar::item:selected {
  background: #16a34a;
  color: white;
}

QMenu {
  background: #f8fafc;
  color: #111827;
}

QMenu::item:selected {
  background: #16a34a;
  color: white;
}

QToolBar {
  background: #f8fafc;
  border-bottom: 1px solid #cbd5e1;
}

QStatusBar {
  background: #e2e8f0;
  color: #475569;
}

QTabWidget::pane {
  border: 1px solid #cbd5e1;
  background: #e2e8f0;
}

QTabBar::tab:selected {
  background: #22c55e;
  color: #ffffff;
  border-radius: 4px;
}

QTabBar::tab:!selected {
  background: #f8fafc;
  color: #111827;
}

QLabel,
QLineEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  color: #111827;
  font-family: Segoe UI, Arial, sans-serif;
}

QLineEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  background: white;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  padding: 6px;
}

QPushButton {
  background: #22c55e;
  color: white;
  border-radius: 8px;
  padding: 8px 14px;
  border: none;
}

QPushButton:hover {
  background: #16a34a;
}

QLabel#preview_label {
  color: #475569;
}
