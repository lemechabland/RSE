















QMainWindow {
  background: #fcfcfc;
  color: #111827;
  font-family: Segoe UI, Arial, sans-serif;
  font-size: 13px;
}

QMenuBar {
  background: #fcfcfc;
  color: #111827;
  padding: 4px 8px;
  spacing: 4px;
  border-bottom: 1px solid #dfe3e8;
}

QMenuBar::item {
  padding: 6px 12px;
  border-radius: 9px;
  background: transparent;
}

QMenuBar::item:selected {
  background: #16a34a;
  color: white;
}

QMenu {
  background: #ffffff;
  color: #111827;
  border: 1px solid #dfe3e8;
  border-radius: 10px;
  padding: 6px;
}

QMenu::item {
  padding: 7px 24px 7px 14px;
  border-radius: 9px;
  margin: 1px;
}

QMenu::item:selected {
  background: #16a34a;
  color: white;
}

QMenu::separator {
  height: 1px;
  background: #dfe3e8;
  margin: 6px 10px;
}

QToolBar {
  background: #fcfcfc;
  border-bottom: 1px solid #dfe3e8;
}

QStatusBar {
  background: #e2e8f0;
  color: #475569;
}

QTabWidget::pane {
  border: none;
  background: #fcfcfc;
}

QTabBar::tab {
  padding: 8px 16px;
  border-radius: 9px;
}

QTabBar::tab:selected {
  background: #22c55e;
  color: #ffffff;
}

QTabBar::tab:!selected {
  background: #fcfcfc;
  color: #111827;
}

QGroupBox {
  background: #ffffff;
  border: 1px solid #dfe3e8;
  border-radius: 14px;
  margin-top: 16px;
  padding: 18px 14px 14px 14px;
  font-weight: 600;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 14px;
  top: 2px;
  padding: 0 8px;
  color: #111827;
  background: #ffffff;
}

QLabel,
QLineEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  color: #111827;
  font-family: Segoe UI, Arial, sans-serif;
}

QLineEdit,
QTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  background: white;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  padding: 7px 9px;
  selection-background-color: #22c55e;
}

QLineEdit:focus,
QTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
  border: 1px solid #22c55e;
}

QPushButton {
  background: #22c55e;
  color: white;
  border-radius: 9px;
  padding: 9px 18px;
  border: none;
  font-weight: 600;
  min-height: 20px;
}

QPushButton:hover {
  background: #16a34a;
}

QPushButton:pressed {
  background: #1f2937;
}

QPushButton:disabled {
  background: #e2e8f0;
  color: #475569;
}

QPushButton[variant="primary"] {
  padding: 11px 22px;
  font-size: 14px;
}

QPushButton[variant="ghost"] {
  background: #e2e8f0;
  color: #111827;
}

QPushButton[variant="ghost"]:hover {
  background: #dfe3e8;
}

QTableWidget {
  background: #ffffff;
  alternate-background-color: #fcfcfc;
  border: 1px solid #dfe3e8;
  border-radius: 9px;
  gridline-color: #dfe3e8;
  selection-background-color: #22c55e;
  selection-color: white;
}

QHeaderView::section {
  background: #e2e8f0;
  color: #111827;
  padding: 6px 8px;
  border: none;
  border-bottom: 1px solid #dfe3e8;
  font-weight: 600;
}

QLabel#preview_label {
  color: #475569;
}
